<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="crm_lead_view_form_inherit_pulse" model="ir.ui.view">
            <field name="name">crm.lead.view.form.inherit.pulse</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='priority']" position="after">
                    <field name="is_critical_iot_alert" invisible="1"/>
                    <field name="patient_heart_rate" style="font-weight: bold; color: red; font-size: 16px;"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
